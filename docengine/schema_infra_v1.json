{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InfrastructureSpecV1",
  "type": "object",
  "required": ["env", "services", "ports"],
  "properties": {
    "env": { "type": "string", "enum": ["development", "staging", "production"] },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "version"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "stopped", "degraded"] },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    }
  },
  "additionalProperties": false
}
