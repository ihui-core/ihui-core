#!/usr/bin/env python3
import sys
import json
from pathlib import Path

try:
    import jsonschema
except ImportError:
    sys.exit(0)

repo_root = Path(__file__).resolve().parent.parent.parent
schema_path = repo_root / "docengine" / "schema_session_v1.json"

if not schema_path.exists():
    sys.exit(0)

try:
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)
except Exception:
    sys.exit(0)

import subprocess
res = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"], cwd=repo_root, capture_output=True, text=True)
if res.returncode != 0:
    sys.exit(0)

staged_files = [repo_root / line.strip() for line in res.stdout.splitlines() if line.strip()]
session_files = [p for p in staged_files if p.parent.name == ".sessions" and p.suffix == ".json"]

if not session_files:
    sys.exit(0)

has_error = False
for file_path in session_files:
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            instance = json.load(f)
        jsonschema.validate(instance=instance, schema=schema)
    except Exception as err:
        has_error = True
        print(f"\n[ERROR] Archivo inválido: {file_path}", file=sys.stderr)
        print(f"Ruta del error (JSON): {getattr(err, 'path', 'raiz')}", file=sys.stderr)
        print(f"Mensaje del validador: {str(err)}\n", file=sys.stderr)

if has_error:
    sys.exit(1)

sys.exit(0)
